    <!-- الشريط السفلي للتنقل -->
    <div id="navBar" class="nav" style="display: none;">
        <button id="navP" class="active" onclick="switchTab('prayerSec', 'navP')"><span>🕌</span><span>الصلاة</span></button>
        <button id="navQ" onclick="switchTab('quranSec', 'navQ')"><span>📖</span><span>القرآن</span></button>
        <button id="navL" onclick="switchTab('liveSec', 'navL')"><span>🕋</span><span>البث</span></button>
        <button id="navT" onclick="switchTab('tasbihSec', 'navT')"><span>📿</span><span>التسبيح</span></button>
        <button onclick="logout()" style="background:none; border:none; color:#ef4444; width:auto; font-size:11px; display:flex; flex-direction:column; align-items:center; gap:4px; cursor:pointer;"><span>⚙️</span><span>تغيير</span></button>
    </div>

    <script>
        let tasbihCount = 0;
        const tasbihPhrases = ["سُبْحَانَ اللَّهِ", "الْحَمْدُ لِلَّهِ", "لَا إِلَهَ إِلَّا اللَّهُ", "اللَّهُ أَكْبَرُ"];
        let phraseIndex = 0;

        window.onload = function() {
            const city = localStorage.getItem('userCity');
            const country = localStorage.getItem('userCountry');
            if (city && country) {
                document.getElementById("loginSec").classList.remove("active");
                document.getElementById("prayerSec").classList.add("active");
                document.getElementById("navBar").style.display = "flex";
                document.getElementById("locationDisplay").textContent = `الموقع الحالي: ${city}, ${country}`;
                fetchPrayerTimes();
            }
        };

        function saveLocation() {
            const city = document.getElementById("cityInput").value.trim();
            const country = document.getElementById("countryInput").value.trim();

            if (!city || !country) {
                alert("⚠️ يرجى إدخال اسم المدينة والدولة!");
                return;
            }

            localStorage.setItem('userCity', city);
            localStorage.setItem('userCountry', country);

            document.getElementById("locationDisplay").textContent = `الموقع الحالي: ${city}, ${country}`;
            document.getElementById("loginSec").classList.remove("active");
            document.getElementById("prayerSec").classList.add("active");
            document.getElementById("navBar").style.display = "flex";
            fetchPrayerTimes();
        }

        function logout() {
            localStorage.clear();
            location.reload();
        }

        function switchTab(secId, btnId) {
            document.querySelectorAll('.section').forEach(s => s.classList.remove('active'));
            document.querySelectorAll('.nav button').forEach(b => {
                if(b.id) b.classList.remove('active');
            });
            
            document.getElementById(secId).classList.add('active');
            if(document.getElementById(btnId)) {
                document.getElementById(btnId).classList.add('active');
            }
        }

        function fetchPrayerTimes() {
            const city = localStorage.getItem('userCity');
            const country = localStorage.getItem('userCountry');
            
            if (!city) return;

            fetch(`https://api.aladhan.com/v1/timingsByCity?city=${encodeURIComponent(city)}&country=${encodeURIComponent(country)}&method=4`)
            .then(res => res.json())
            .then(data => {
                if (data.code === 200) {
                    const timings = data.data.timings;
                    document.getElementById("pFajr").textContent = timings.Fajr;
                    document.getElementById("pSunrise").textContent = timings.Sunrise;
                    document.getElementById("pDhuhr").textContent = timings.Dhuhr;
                    document.getElementById("pAsr").textContent = timings.Asr;
                    document.getElementById("pMaghrib").textContent = timings.Maghrib;
                    document.getElementById("pIsha").textContent = timings.Isha;
                } else {
                    alert("❌ تعذر جلب مواقيت الصلاة، تأكد من صحة اسم المدينة.");
                }
            })
            .catch(() => {
                alert("❌ خطأ في الاتصال بالإنترنت أثناء جلب المواقيت.");
            });
        }

        // تشغيل سور القرآن الكريم حسب الشيخ والسورة المختارة
        function playSurah(surahNumber, surahName) {
            const sheikh = document.getElementById("sheikhSelect").value;
            const audioPlayer = document.getElementById("audioPlayer");
            const nowPlaying = document.getElementById("nowPlayingText");

            // رابط مباشر حقيقي من شبكة القرآن الكريم (mp3quran / audio api)
            // استخدام رابط استماع معتمد للسور
            let formattedSurah = String(surahNumber).padStart(3, '0');
            
            let audioUrl = "";
            if (sheikh === 'ar.alafasy') {
                audioUrl = `https://server8.mp3quran.net/afs/${formattedSurah}.mp3`;
            } else if (sheikh === 'ar.abdulbasit') {
                audioUrl = `https://server7.mp3quran.net/basit/Almusshaf-Almujawwad/${formattedSurah}.mp3`;
            } else if (sheikh === 'ar.sudais') {
                audioUrl = `https://server11.mp3quran.net/sds/${formattedSurah}.mp3`;
            } else {
                audioUrl = `https://server10.mp3quran.net/maher/${formattedSurah}.mp3`;
            }

            audioPlayer.src = audioUrl;
            audioPlayer.style.display = "block";
            audioPlayer.play();
            nowPlaying.textContent = `جاري الاستماع إلى: ${surahName}`;
        }

        function incrementTasbih() {
            tasbihCount++;
            document.getElementById("counterVal").textContent = tasbihCount;
            
            if (tasbihCount % 33 === 0) {
                phraseIndex = (phraseIndex + 1) % tasbihPhrases.length;
                document.getElementById("tasbihText").textContent = tasbihPhrases[phraseIndex];
            }
        }

        function resetTasbih() {
            tasbihCount = 0;
            phraseIndex = 0;
            document.getElementById("counterVal").textContent = tasbihCount;
            document.getElementById("tasbihText").textContent = tasbihPhrases[0];
        }
    </script>
</body>
</html>
